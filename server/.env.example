# Copy to .env locally and adjust if needed
LANCEDB_URI=./lancedb_db
EMBED_MODEL=google/siglip-base-patch16-256
EMBED_DIM=768
DATA_DIR=data

# Optional: restore prod dataset locally for testing without polluting it.
# When PERSISTENCE_READ_ONLY=1, restore_from_repo() runs but sync_to_repo()
# becomes a no-op, so local ingestion never pushes to the live dataset.
# HF_DATASET_REPO=aariz-s/segp-siglip-data
# HF_TOKEN=hf_...
# PERSISTENCE_READ_ONLY=1
